# Copy this file to .env and fill in your actual values.
# Never commit .env — it is listed in .gitignore.

# ---- Database ----
# PostgreSQL connection string for the judge evaluation database.
# Default matches the docker-compose service defined in the repo.
DATABASE_URL=postgresql+psycopg2://judge_user:judge_pass@localhost:5432/llm_judge_db

# ---- Judge Model APIs ----
# Groq (primary judge model — Llama 3.3-70B)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (fallback judge model — Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Optional ----
# Hugging Face token (needed if you use private HF models or exceed rate limits)
# HUGGINGFACE_TOKEN=your_hf_token_here
