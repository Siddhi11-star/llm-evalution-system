# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=judgeai_db

# Ollama Cloud (priority 1)
OLLAMA_CLOUD_URL=https://your-ollama-cloud-endpoint.com
OLLAMA_CLOUD_MODEL=qwen3:14b

# Ollama Local (priority 2)
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=qwen3:14b

# Groq (priority 3)
GROQ_API_KEY=your-groq-api-key-here

# HuggingFace (priority 4)
HF_API_TOKEN=your-hf-token-here
